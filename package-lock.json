{
  "name": "dicewars-planets",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "dicewars-planets",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@dicewars/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@dicewars/planets": {
      "resolved": "packages/planets",
      "link": true
    },
    "packages/core": {
      "name": "@dicewars/core",
      "version": "0.1.0"
    },
    "packages/planets": {
      "name": "@dicewars/planets",
      "version": "0.1.0",
      "dependencies": {
        "@dicewars/core": "*"
      }
    }
  }
}
