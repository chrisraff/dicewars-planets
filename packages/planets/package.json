{
  "name": "@dicewars/planets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run lint && vite build && node scripts/assert-deployable.js && npm run build:preview",
    "build:site": "vite build",
    "build:preview": "vite build --config vite.preview.config.js",
    "preview": "vite preview",
    "lint": "node scripts/lint-conventions.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@dicewars/core": "*",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "vite": "^8.2.1"
  }
}
